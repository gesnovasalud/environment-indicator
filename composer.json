{
  "name": "gesnovasalud/environment-indicator",
  "description": "Filament plugin that shows a colored bar and badge with the current environment, version and git branch.",
  "keywords": [
    "gesnovasalud",
    "laravel",
    "filamentphp",
    "filament",
    "filament-plugin",
    "environment-indicator"
  ],
  "homepage": "https://github.com/gesnovasalud/environment-indicator",
  "support": {
    "issues": "https://github.com/gesnovasalud/environment-indicator/issues",
    "source": "https://github.com/gesnovasalud/environment-indicator"
  },
  "license": "MIT",
  "authors": [
    {
      "name": "Alvaro Torres",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.3",
    "filament/filament": "^5.0",
    "spatie/laravel-package-tools": "^1.15.0"
  },
  "require-dev": {
    "larastan/larastan": "^3.0",
    "laravel/pint": "^1.0",
    "nunomaduro/collision": "^8.0",
    "orchestra/testbench": "^9.0|^10.0|^11.0",
    "pestphp/pest": "^3.7|^4.0",
    "pestphp/pest-plugin-arch": "^3.0|^4.0",
    "pestphp/pest-plugin-laravel": "^3.0|^4.0",
    "pestphp/pest-plugin-livewire": "^3.0|^4.0"
  },
  "autoload": {
    "psr-4": {
      "Gesnovasalud\\EnvironmentIndicator\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Gesnovasalud\\EnvironmentIndicator\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
    "analyse": "phpstan analyse",
    "lint": "pint",
    "test": "pest --no-coverage",
    "test:lint": "pint --test"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Gesnovasalud\\EnvironmentIndicator\\EnvironmentIndicatorServiceProvider"
      ]
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "composer/package-versions-deprecated": true,
      "pestphp/pest-plugin": true,
      "phpstan/extension-installer": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
